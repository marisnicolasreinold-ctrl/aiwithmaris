# ── Vercel-Projektvariablen ──────────────────────────────────────────────
# Nötig für die beiden Functions unter api/. Ohne sie fällt die Seite sauber
# zurück (Reveal-Link geht aufs Kontaktformular), aber richtig funktioniert
# sie erst, wenn CONTACT_EMAIL und SUPABASE_SERVICE_KEY gesetzt sind.

# api/reveal.js — die Adresse, die nach einem echten Klick herausgegeben wird.
# Sie steht bewusst NUR hier und in den Projektvariablen, nirgends im Code:
# genau das ist der Schutz. Am besten eine Rollen-Adresse auf eigener Domain,
# die sich austauschen lässt, wenn sie zugespammt wird.
CONTACT_EMAIL=

# api/contact.js — Kontaktformular
# Service-Role-Key des Supabase-Projekts. Ersetzt den Publishable-Key, der
# vorher im Browser stand. Alternativ SUPABASE_ANON_KEY, dann greifen aber die
# RLS-Regeln der Tabelle kontaktanfragen.
SUPABASE_SERVICE_KEY=
# Optional, Vorgabe ist das bestehende Projekt:
SUPABASE_URL=

# Benachrichtigung über neue Anfragen — komplett optional.
# Fehlt eine der drei, verschickt die Function keine Mail; die Anfragen stehen
# trotzdem in der Tabelle kontaktanfragen und damit im Dashboard unter /admin.
RESEND_API_KEY=
NOTIFY_EMAIL=
MAIL_FROM=

# ── Gastzugang /lsu (middleware.js) ──────────────────────────────────────
# Ohne diese beiden läuft die Prüfung über die Supabase-Funktion check_site_guest.
LSU_USER=
LSU_PASSWORD=

# ── Kein Vercel-Thema ────────────────────────────────────────────────────
# Checkout & Download laufen als Supabase Edge Functions (Projekt aiwithmaris):
#   - Stripe-Secret-Key liegt verschlüsselt im Supabase Vault ("stripe_secret_key")
#   - PDFs liegen im privaten Storage-Bucket "guides"
# Key-Wechsel (z. B. für den Live-Gang) im Supabase SQL-Editor:
#   select vault.update_secret(id, '<neuer sk_...>') from vault.secrets where name = 'stripe_secret_key';
